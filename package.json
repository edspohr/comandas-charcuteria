{
  "name": "comandas-charcuteria",
  "private": true,
  "version": "0.1.0",
  "description": "Mockup funcional de captura y fulfillment de pedidos para La Charcutería Artesanal (Cecinas Marcosi SpA)",
  "workspaces": [
    "app",
    "functions"
  ],
  "scripts": {
    "dev": "npm --workspace app run dev",
    "build": "npm --workspace app run build",
    "emulators": "firebase emulators:start --import=.emulator-data --export-on-exit",
    "seed": "tsx scripts/seed.ts",
    "test:rules": "vitest run tests/rules"
  },
  "dependencies": {
    "firebase-admin": "^12.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.1"
  }
}
