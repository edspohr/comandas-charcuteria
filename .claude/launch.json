{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app-real-firebase",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--mode",
        "production",
        "--port",
        "5173",
        "--strictPort"
      ],
      "cwd": "app",
      "port": 5173
    },
    {
      "name": "emulators",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PATH=/opt/homebrew/opt/openjdk@21/bin:/Users/espohr/.nvm/versions/node/v22.19.0/bin:/opt/homebrew/bin:/usr/bin:/bin",
        "firebase",
        "emulators:start",
        "--only",
        "auth,firestore,functions",
        "--project",
        "comandas-charcuteria-demo"
      ],
      "port": 4000
    },
    {
      "name": "app-emulators",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_USE_EMULATORS=true",
        "VITE_DEMO_LOGIN=true",
        "VITE_FIREBASE_PROJECT_ID=comandas-charcuteria-demo",
        "npx",
        "vite",
        "--port",
        "5174",
        "--strictPort"
      ],
      "cwd": "app",
      "port": 5174
    },
    {
      "name": "fake-bsale",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "tsx",
        "scripts/fake-bsale.ts"
      ],
      "port": 4010
    },
    {
      "name": "app-emulators-real",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "VITE_USE_EMULATORS=true",
        "VITE_DEMO_LOGIN=true",
        "VITE_BSALE_MODE=real",
        "VITE_FIREBASE_PROJECT_ID=comandas-charcuteria-demo",
        "npx",
        "vite",
        "--port",
        "5175",
        "--strictPort"
      ],
      "cwd": "app",
      "port": 5175
    }
  ]
}
