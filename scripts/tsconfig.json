{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "@/*": ["../app/src/*"]
    }
  },
  "include": [
    "./**/*.ts",
    "../app/src/domain/types.ts",
    "../app/src/domain/parse/local.ts",
    "../app/src/domain/parse/client.ts"
  ]
}
