# Set these to point the client to a real Firebase project when deploying.
# Emulators do not need any of these values — dev mode wires them automatically.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=comandas-charcuteria-demo
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=true

# Only required if deploying the parseOrder function with real Claude calls.
# Requires Firebase Blaze plan. Without it the deterministic fallback runs.
ANTHROPIC_API_KEY=

# --- Firebase App Check (obligatorio para Firebase AI Logic / Gemini) ---
# Site key de reCAPTCHA v3 registrada en Firebase Console → App Check → Apps.
VITE_RECAPTCHA_SITE_KEY=
# Solo desarrollo local: genera un debug token (se imprime una vez en consola;
# registrarlo en App Check → Apps → Manage debug tokens). Opcionalmente fijalo:
VITE_APPCHECK_DEBUG=false
VITE_APPCHECK_DEBUG_TOKEN=
