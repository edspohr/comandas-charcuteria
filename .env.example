# Set these to point the client to a real Firebase project when deploying.
# Emulators do not need any of these values — dev mode wires them automatically.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=comandas-charcuteria-demo
VITE_FIREBASE_APP_ID=
VITE_USE_EMULATORS=true

# Only required if deploying the parseOrder function with real Claude calls.
# Requires Firebase Blaze plan. Without it the deterministic fallback runs.
ANTHROPIC_API_KEY=

# --- Firebase App Check (obligatorio para Firebase AI Logic / Gemini) ---
# Key id de reCAPTCHA *Enterprise* (score) registrada como proveedor de App Check.
# La crea y registra `npm run appcheck:setup` (requiere `gcloud auth login`).
# Es un valor público; `localhost` está entre los dominios permitidos.
VITE_RECAPTCHA_SITE_KEY=
# Solo si reCAPTCHA no puede correr (CI, emuladores): debug token registrado en
# App Check → Apps → Manage debug tokens.
VITE_APPCHECK_DEBUG=false
VITE_APPCHECK_DEBUG_TOKEN=
