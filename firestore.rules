rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Helpers
    function isAuth() { return request.auth != null; }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isSuperAdmin()  { return isAuth() && role() == 'superAdmin'; }
    function isAdminOrSup()  { return isAuth() && (role() == 'admin' || role() == 'superAdmin'); }
    function isVendedor()    { return isAuth() && role() == 'vendedor'; }
    function isDespacho()    { return isAuth() && role() == 'despacho'; }
    function isProduccion()  { return isAuth() && role() == 'produccion'; }

    // -------- Reference data
    match /products/{id} {
      allow read:  if isAuth();
      allow write: if isAdminOrSup();
    }

    match /clients/{id} {
      allow read:  if isAuth();
      // Alta rápida desde el wizard / parser: el vendedor crea el cliente
      // marcado needsReview; administración lo completa después.
      allow create: if isAdminOrSup()
        || (isVendedor() && request.resource.data.createdBy == request.auth.uid);
      // sync mirrors Bsale into clients/*: any role that can run the sync.
      allow update: if isAdminOrSup() || isDespacho() || isProduccion();
      allow delete: if isAdminOrSup();
    }

    match /settings/{doc} {
      allow read:  if isAuth();
      // bsaleSync is the "last sync" summary written by whoever ran the sync.
      allow write: if isSuperAdmin() || (doc == 'bsaleSync' && isAuth() && !isVendedor());
    }

    // -------- Bsale mirror (simulated Bsale side for the demo)
    // In production these collections disappear: the app reads Bsale's API.
    match /bsaleMock/{doc} {
      allow read:  if isAuth();
      allow write: if isAdminOrSup();
    }
    match /bsaleDocuments/{id} {
      allow read:   if isAuth();
      allow create: if isAdminOrSup();
      // linking a document to an order only sets linkedOrderId
      allow update: if isAdminOrSup();
      allow delete: if isSuperAdmin();
    }
    // Client master in Bsale. Alta rápida = POST /v1/clients.json, so
    // vendedores may create; edits happen in Bsale (admin here for the demo).
    match /bsaleClients/{id} {
      allow read:   if isAuth();
      allow create: if isVendedor() || isAdminOrSup();
      allow update: if isAdminOrSup();
      allow delete: if isSuperAdmin();
    }
    match /bsaleReceptions/{id} {
      allow read:   if isAuth();
      allow create: if isAdminOrSup();
      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read:  if isAuth();
      allow write: if isSuperAdmin();
    }

    // -------- Counters
    // orders-YYYY is bumped by createOrder → any role that can create orders.
    // bsale-YYYY is bumped by facturarOrder → admin/superAdmin only.
    // Read is allowed to any authenticated user so the transaction preview
    // step doesn't need extra permissions.
    match /counters/{id} {
      allow read: if isAuth();
      // orders-YYYY: any authenticated user with an order-creating role.
      allow write: if id.matches('orders-.*') && (isVendedor() || isAdminOrSup());
      // bsale-YYYY: only invoice-creating roles.
      allow write: if id.matches('bsale-.*') && isAdminOrSup();
    }

    // -------- Stock mirror of Bsale (mutated only by transactions in code)
    // - Vendedor can touch reserved only (createOrder / anular releases). onHand
    //   must NOT change.
    // - Despacho / Producción / Admin run syncStockFromBsale, which overwrites
    //   onHand with what Bsale reports and moves reserved when absorbing
    //   pending production. Admin also releases reservations on
    //   vincularDocumento.
    // Rules always enforce non-negative onHand and reserved.
    match /stock/{id} {
      allow read: if isAuth();

      allow create: if (isAdminOrSup() || isDespacho() || isProduccion())
        && request.resource.data.onHand >= 0
        && request.resource.data.reserved >= 0;

      allow update: if isAuth()
        && request.resource.data.onHand >= 0
        && request.resource.data.reserved >= 0
        && (
          isAdminOrSup()
          // Vendedor: cannot move onHand.
          || (isVendedor() && request.resource.data.onHand == resource.data.onHand)
          // Despacho + Producción: sync writes (onHand ← Bsale, reserved ←
          // FIFO absorption). The invariants above still apply.
          || isDespacho()
          || isProduccion()
        );

      allow delete: if isAdminOrSup();
    }

    // -------- Stock movements (append-only audit log)
    match /stockMovements/{id} {
      allow read:   if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    // -------- Orders
    match /orders/{id} {
      allow read: if isAuth();

      // Create: vendedor/admin/superAdmin; must own the order (createdBy = uid),
      // must start in a legal initial state.
      allow create: if isAuth()
        && (isVendedor() || isAdminOrSup())
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['recibido', 'confirmado', 'confirmado_parcial'];

      // Update: split by role.
      // Admin/SuperAdmin can update anything on an order.
      // Vendedor: only own orders, only to transition to 'anulado' from a
      //   pre-invoice state. Cannot set invoiceRef, cannot change createdBy.
      // Despacho: cannot set invoiceRef; can only push order forward through
      //   pack states (en_armado / armado).
      // Producción: reassigns pending → reserved on lines and may transition
      //   confirmado_parcial → confirmado. Cannot set invoiceRef.
      allow update: if isAuth() && (
        isAdminOrSup()
        || (
          isVendedor()
          && resource.data.createdBy == request.auth.uid
          && resource.data.status in ['recibido', 'confirmado', 'confirmado_parcial', 'en_armado']
          && request.resource.data.status == 'anulado'
          && request.resource.data.createdBy == resource.data.createdBy
          && request.resource.data.get('invoiceRef', null) == resource.data.get('invoiceRef', null)
        )
        || (
          isDespacho()
          && resource.data.status in ['confirmado', 'confirmado_parcial', 'en_armado']
          && request.resource.data.status in ['en_armado', 'armado']
          && request.resource.data.get('invoiceRef', null) == resource.data.get('invoiceRef', null)
          && request.resource.data.createdBy == resource.data.createdBy
        )
        || (
          // Sync promotes partial orders; despacho can trigger it too.
          (isProduccion() || isDespacho())
          && resource.data.status in ['confirmado_parcial', 'recibido']
          && request.resource.data.status in ['confirmado_parcial', 'confirmado']
          && request.resource.data.get('invoiceRef', null) == resource.data.get('invoiceRef', null)
          && request.resource.data.createdBy == resource.data.createdBy
        )
      );

      allow delete: if isSuperAdmin();
    }
  }
}
