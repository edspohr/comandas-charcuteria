rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------- Perfiles (custom claim `role`, escrito solo por las Cloud
    // Functions de usuarios). Esta matriz replica app/src/domain/permissions.ts;
    // si se toca una, tocar la otra.
    function isAuth()  { return request.auth != null; }
    function role()    { return isAuth() && ('role' in request.auth.token) ? request.auth.token.role : null; }
    function hasRole() { return role() != null; }
    function roleIn(list) { return role() in list; }

    function isSuperAdmin()   { return role() == 'superAdmin'; }
    function isSupervisor()   { return roleIn(['admin', 'superAdmin']); }
    function canCreateOrder() { return roleIn(['vendedor', 'tienda', 'admin', 'superAdmin']); }
    function canPack()        { return roleIn(['despacho', 'admin', 'superAdmin']); }
    function canDispatch()    { return roleIn(['despacho', 'reparto', 'admin', 'superAdmin']); }
    function canDeliver()     { return roleIn(['reparto', 'admin', 'superAdmin']); }
    function canSync()        { return roleIn(['despacho', 'produccion', 'admin', 'superAdmin']); }
    function canReceiveProd() { return roleIn(['produccion', 'admin', 'superAdmin']); }
    function canQuickClient() { return roleIn(['vendedor', 'tienda', 'admin', 'superAdmin']); }
    // Lectura: cualquier perfil (el consultor ve todo, sin escribir nada).
    function canRead()        { return hasRole(); }

    function unchanged(field) {
      return request.resource.data.get(field, null) == resource.data.get(field, null);
    }

    // -------- Reference data
    match /products/{id} {
      allow read:  if canRead();
      allow write: if isSupervisor();
    }

    match /clients/{id} {
      allow read:  if canRead();
      // Alta rápida desde el wizard / parser: queda needsReview y
      // administración la completa después.
      allow create: if isSupervisor()
        || (canQuickClient() && request.resource.data.createdBy == request.auth.uid);
      // El sync espeja Bsale en clients/*: cualquier perfil que sincroniza.
      allow update: if isSupervisor() || canSync()
        // Quien toma pedidos deja el horario habitual del cliente y, si no
        // tenía, su nombre de fantasía. Nada más de la ficha.
        || (canCreateOrder()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryWindow', 'receivingHours', 'fantasyName'])
          && (resource.data.get('fantasyName', '') == '' || unchanged('fantasyName')));
      allow delete: if isSupervisor();
    }

    match /settings/{doc} {
      allow read:  if canRead();
      // bsaleSync es el resumen de la última sincronización.
      allow write: if isSuperAdmin() || (doc == 'bsaleSync' && canSync());
    }

    // -------- Bsale simulado (solo modo mock / desarrollo)
    match /bsaleMock/{doc} {
      allow read:  if canRead();
      allow write: if isSupervisor() || canReceiveProd();
    }
    match /bsaleDocuments/{id} {
      allow read:   if canRead();
      allow create: if isSupervisor();
      allow update: if isSupervisor();
      allow delete: if isSuperAdmin();
    }
    match /bsaleClients/{id} {
      allow read:   if canRead();
      allow create: if canQuickClient();
      allow update: if isSupervisor();
      allow delete: if isSuperAdmin();
    }
    match /bsaleReceptions/{id} {
      allow read:   if canRead();
      allow create: if canReceiveProd();
      allow update, delete: if false;
    }

    // -------- Bsale real: espejos y diagnósticos que escriben solo las
    // Cloud Functions (Admin SDK, salta reglas). El cliente solo lee.
    match /bsale/{doc=**} {
      allow read:  if canRead();
      allow write: if false;
    }
    // Excepción: al vincular un documento la app marca linkedOrderId (y nada más).
    match /bsale/sales/documents/{id} {
      allow update: if isSupervisor()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedOrderId']);
    }
    // Cruce variante Bsale ↔ producto/formato de la app.
    match /catalogMap/{variantId} {
      allow read:  if canRead();
      allow write: if isSupervisor();
    }

    // Resúmenes calculados por scripts (Su mes en números). Solo lectura.
    match /insights/{id} {
      allow read:  if canRead();
      allow write: if false;
    }

    // -------- Usuarios: solo las Cloud Functions escriben.
    match /users/{uid} {
      // El propio doc se puede leer antes de tener claim (primer ingreso).
      allow read:  if canRead() || (isAuth() && request.auth.uid == uid);
      allow write: if false;
    }
    match /invites/{email} {
      allow read:  if isSuperAdmin() || role() == 'consultor';
      allow write: if false;
    }

    // -------- Counters
    match /counters/{id} {
      allow read: if canRead();
      allow write: if id.matches('orders-.*') && canCreateOrder();
      allow write: if id.matches('bsale-.*') && isSupervisor();
    }

    // -------- Stock: espejo de Bsale (onHand) + reservas de la app.
    match /stock/{id} {
      allow read: if canRead();

      allow create: if (isSupervisor() || canSync())
        && request.resource.data.onHand >= 0
        && request.resource.data.reserved >= 0;

      allow update: if hasRole()
        && request.resource.data.onHand >= 0
        && request.resource.data.reserved >= 0
        && (
          isSupervisor()
          // Sync: onHand ← Bsale, reserved ← reasignación FIFO.
          || canSync()
          // Quien toma pedidos solo mueve reservas.
          || (canCreateOrder() && request.resource.data.onHand == resource.data.onHand)
        );

      allow delete: if isSupervisor();
    }

    // -------- Bitácora de stock (append-only, firmada por quien la escribe)
    match /stockMovements/{id} {
      allow read:   if canRead();
      allow create: if hasRole() && role() != 'consultor' && request.resource.data.by == request.auth.uid;
      allow update, delete: if false;
    }

    // -------- Orders
    // Seguimiento de muestras: lo responde el vendedor (o administración).
    match /sampleFeedback/{id} {
      allow read:  if canRead();
      allow write: if (canCreateOrder() && request.resource.data.by == request.auth.uid) || isSupervisor();
    }

    match /orders/{id} {
      allow read: if canRead();

      allow create: if canCreateOrder()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status in ['recibido', 'confirmado', 'confirmado_parcial'];

      allow update: if hasRole() && (
        isSupervisor()
        || (
          // Quien lo creó puede anularlo antes de facturar.
          canCreateOrder()
          && resource.data.createdBy == request.auth.uid
          && resource.data.status in ['recibido', 'confirmado', 'confirmado_parcial', 'en_armado']
          && request.resource.data.status == 'anulado'
          && unchanged('createdBy') && unchanged('invoiceRef')
        )
        || (
          canPack()
          && resource.data.status in ['confirmado', 'confirmado_parcial', 'en_armado']
          && request.resource.data.status in ['en_armado', 'armado']
          && unchanged('createdBy') && unchanged('invoiceRef')
        )
        || (
          // Reposición de tienda: despacho registra el traslado (no se factura).
          canPack()
          && resource.data.get('kind', '') == 'reposicion'
          && resource.data.status == 'armado'
          && request.resource.data.status == 'facturado'
          && request.resource.data.invoiceRef.matches('^TR-.*')
          && unchanged('createdBy') && unchanged('lines') && unchanged('kind')
        )
        || (
          // Pedido solo de muestras: despacho registra la salida (consumo
          // interno en Bsale, no se factura).
          canPack()
          && resource.data.get('kind', '') == 'muestras'
          && resource.data.status == 'armado'
          && request.resource.data.status == 'facturado'
          && request.resource.data.invoiceRef.matches('^MU-.*')
          && unchanged('createdBy') && unchanged('lines') && unchanged('kind')
        )
        || (
          // La tienda confirma que recibió su reposición.
          role() == 'tienda'
          && resource.data.get('kind', '') == 'reposicion'
          && resource.data.status == 'despachado'
          && request.resource.data.status == 'entregado'
          && unchanged('createdBy') && unchanged('invoiceRef') && unchanged('lines')
        )
        || (
          canDispatch()
          && resource.data.status == 'facturado'
          && request.resource.data.status == 'despachado'
          && unchanged('createdBy') && unchanged('invoiceRef') && unchanged('lines')
        )
        || (
          canDeliver()
          && resource.data.status == 'despachado'
          && request.resource.data.status == 'entregado'
          && unchanged('createdBy') && unchanged('invoiceRef') && unchanged('lines')
        )
        || (
          // La sincronización promueve pedidos parciales.
          canSync()
          && resource.data.status in ['confirmado_parcial', 'recibido']
          && request.resource.data.status in ['confirmado_parcial', 'confirmado']
          && unchanged('createdBy') && unchanged('invoiceRef')
        )
      );

      allow delete: if isSuperAdmin();
    }
  }
}
